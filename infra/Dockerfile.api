ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE} AS runtime
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Optional egress proxy for build-time downloads (unset when not provided).
ARG HTTP_PROXY=
ARG HTTPS_PROXY=

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    UV_INDEX_URL=${UV_INDEX_URL} \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY}

WORKDIR /app
RUN pip install --no-cache-dir --timeout 120 uv==0.9.28

COPY backend/pyproject.toml /app/pyproject.toml
COPY backend/uv.lock /app/uv.lock
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/src /app/src
COPY backend/migrations /app/migrations
RUN uv sync --frozen --no-dev

# Scrub proxy from the runtime image: api/worker must not route notifications
# or webhook calls through the build-time proxy.
ENV HTTP_PROXY= \
    HTTPS_PROXY= \
    http_proxy= \
    https_proxy=

ENV PATH="/app/.venv/bin:${PATH}"
CMD ["personal-affairs-api"]
